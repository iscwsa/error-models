
{
	"$schema"     : "https://json-schema.org/draft-07/schema",
	"$id"         : "https://github.com/iscwsa/error-models/blob/main/schema.json",
	"type"        : "object",
	"title"       : "Metadata",
	"description" : "Information about the model",

	"properties": {

		"framework": {
			"description": "Error Model framework",
			"type": "string"
		},

		"name": {
			"description": "Some details about the model here, perhaps restrictions or recommendations?",
			"type": "string"
		},

		"description": {
			"description": "Summary of the Error Model",
			"type": "string"
		},

		"supplier": {
			"description": "Who created the model",
			"type": "string"
		},

		"model_id": {
			"description": "As defined by supplier",
			"type": "string"
		},

		"revision": {
			"description": "Model revision number",
			"type": "integer",
			"minimum": 0
		},

		"date": {
			"description": "Model revision date",
			"type": "string",
			"format": "date"
		},

		"iscwsa_model": {
			"description": "Is this a published ISCWSA error model?",
			"type": "boolean"
		},

		"uuid": {
			"description": "UUID for entire JSON",
			"type": "string"
		},

		"checksum": {
			"description": "Checksum of entire JSON",
			"type": "string"
		}

	},

	"required": [
		"framework",
		"name",
		"description",
		"supplier",
		"model_id",
		"revision",
		"date",
		"iscwsa_model",
		"uuid",
		"checksum"
	],

	"additionalProperties" : false

}

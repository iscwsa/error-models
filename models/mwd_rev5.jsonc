{
	"$schema": "../schemas/draft.json",

	"metadata": {

		// TODO: Determine which UUID format to use.
		"schema_uuid": "00000000-0000-0000-0000-000000000000",
		"model_uuid" : "00000000-0000-0000-0000-000000000000",

		// Existing fields (keep)
		"model_id"        : "A001Mc", // As defined by the author
		"short_name"      : "MWD+SRGM",
		"long_name"       : "OWSG MWD + SRGM",
		"revision_number" : 5.1,
		"revision_date"   : "2020-10-08",
		"revision_comment": "Rev No changed to match ISCWSA Models (Rev.5). XCLA & XCLH terms added. XYM3 replaced by XYM3E. XYM4 replaced by XYM4E. SAG replaced by SAGE. DECG replaced by DEC-U DEC-OS DEC-OH DEC-OI. DBHG replaced by DBH-U DBH-OS DBH-OH DBH-OI. Updated Short Name, Long Name, Application.",
		"source"          : "OWSG - SPE 67616 and 63275",
		"application"     : "MWD using 1-Year Standard Resolution Geomagnetic Mode (e.g., BGGM up to 2018, MVSD) with no additional corrections",
		"tool_type"       : "Magnetic",

		// Existing fields (propose delete)
		// TBD

		// New fields
		"author"          : "ISCWSA",
		"framework"       : "ISCWSA Rev5",

		// Optional
		"tags": []

	},

	"parameters": {
		"inc_min" : 0,
		"inc_max" : 180
	},

	// TODO: Identify implicitly paired or dependent terms and singularities
	// TODO: Split magnitudes out of term definition
	// TODO: Split out weighting functions because some terms use the same WF with different magnitudes
	// TODO: Field for mixed-modes, e.g., static vs dynamic (rotating)
	"terms": [
		{
			"uuid"                 : "00000000-0000-0000-0000-000000000000",
			"name"                 : "DBH-R",
			"value"                : 3000,
			"units"                : "deg/nT",
			"depth_factor"         : 1,
			"inclination_factor"   : 1,
			"azimuth_factor"       : 1,
			"propagation_mode"     : "Random",
			"depth_formula"        : "0",
			"inclination_formula"  : "0",
			"azimuth_formula"      : "1 / (BField * Cos(Dip))",
			"north_singularity"    : null,
			"east_singularity"     : null,
			"vertical_singularity" : null,
			"hash_value"           : "00000000000000000000000000000000"
		},
		{
			"uuid"                 : "00000000-0000-0000-0000-000000000000",
			"name"                 : "XCLA",
			"value"                : 0.167,
			"units"                : "deg",
			"depth_factor"         : 1,
			"inclination_factor"   : 1,
			"azimuth_factor"       : 1,
			"propagation_mode"     : "Systematic",
			"depth_formula"        : "0",
			"inclination_formula"  : "0",
			"azimuth_formula"      : "Max(Sin(Abs(AzT-AzPrev)), XCLTortuosity * (MD-MDPrev) / Sin(Inc))",
			"north_singularity"    : "XCLTortuosity * RAD * (MD - MDPrev)",
			"east_singularity"     : "XCLTortuosity * RAD * (MD - MDPrev)",
			"vertical_singularity" : null,
			"hash_value"           : "00000000000000000000000000000000"
		}
	],

	// TODO: Determine function to calculate hash. The order of terms is significant.
	// TODO: Do we really need hashed values for the individual terms? Can we publish
	// a "library" of the ISCWSA terms and refer to them by UUID?
	"hash_function" : "SHA256",
	"hash_value"    : "00000000000000000000000000000000"

}

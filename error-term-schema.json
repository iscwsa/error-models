{
	"$schema"              : "https://json-schema.org/draft-07/schema",
	"$id"                  : "https://github.com/iscwsa/error-models/blob/main/error-term-schema.json",
	"type"                 : "object",
	"title"                : "Error Term Schema",
	"description"          : "Provides validation of Error Terms",
	"markdownDescription"  : "Provides validation of Error Terms. See [iscwsa.net](https://www.iscwsa.net/committees/error-model/)",
	"properties"           : {

		"name": {
			"description": "",
			"type": "string"
		},

		"value": {
			"description": "Value or Magnitude",
			"type": "number"
		},

		"units": {
			"description": "",
			"type": "string",
			"enum": ["m", "1/m", "nT", "m/s2", "deg", "deg/nT", "deg/hr", "rad"]
		},

		"depth_factor": {
			"description": "",
			"type": "number",
			"minimum": 0
		},

		"inclination_factor": {
			"description": "",
			"type": "number",
			"minimum": 0
		},

		"azimuth_factor": {
			"description": "",
			"type": "number",
			"minimum": 0
		},

		"propagation_mode": {
			"description": "",
			"type": "string",
			"enum": ["Global", "Random", "Systematic", "Well"]
		},

		"depth_formula": {
			"description": "",
			"type": "string"
		},

		"inclination_formula": {
			"description": "",
			"type": "string"
		},

		"azimuth_formula": {
			"description": "",
			"type": "string"
		},

		"north_singularity": {
			"description": "",
			"type": "string"
		},

		"east_singularity": {
			"description": "",
			"type": "string"
		},

		"vertical_singularity": {
			"description": "",
			"type": "string"
		},

		"iscwsa_term": {
			"description": "Is this a published ISCWSA error term?",
			"type": "boolean"
		},

		"uuid": {
			"description": "UUID of individual error term",
			"type": "string"
		},

		"checksum": {
			"description": "Checksum of individual error term",
			"type": "string"
		}

	},

	"required": [
		"name",
		"value",
		"units",
		"depth_factor",
		"inclination_factor",
		"azimuth_factor",
		"propagation_mode",
		"depth_formula",
		"inclination_formula",
		"north_singularity",
		"east_singularity",
		"vertical_singularity",
		"azimuth_formula",
		"iscwsa_term",
		"uuid",
		"checksum"
	],

	"additionalProperties" : false

}

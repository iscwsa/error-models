{
	"$schema"     : "https://json-schema.org/draft/2020-12/schema",
	"$id"         : "https://github.com/iscwsa/error-models/blob/main/schemas/error_term.json",
	"type"        : "object",
	"title"       : "Error Term",
	"description" : "An individual Error Term",
	"examples"    : ["DREF", "SAG", "XYM3E"],

	"properties"  : {

		"name": {
			"description": "",
			"type": "string"
		},

		"value": {
			"description": "Value or Magnitude",
			"type": "number"
		},

		"units": {
			"description": "",
			"type": "string",
			"enum": ["m", "1/m", "nT", "m/s2", "deg", "deg/nT", "deg/hr", "rad"]
		},

		"depth_factor": {
			"description" : "",
			"type"        : "number",
			"minimum"     : 0
		},

		"inclination_factor": {
			"description" : "",
			"type"        : "number",
			"minimum"     : 0
		},

		"azimuth_factor": {
			"description" : "",
			"type"        : "number",
			"minimum"     : 0
		},

		"propagation_mode": {
			"description" : "",
			"type"        : "string",
			"enum"        : ["Global", "Random", "Systematic", "Well"]
		},

		"depth_formula": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"inclination_formula": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"azimuth_formula": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"north_singularity": {
			"description" : "",
			"type"        : ["string", "null"],
			"minLength"   : 1
		},

		"east_singularity": {
			"description" : "",
			"type"        : ["string", "null"],
			"minLength"   : 1
		},

		"vertical_singularity": {
			"description" : "",
			"type"        : ["string", "null"],
			"minLength"   : 1
		},

		"uuid": {
			"description" : "UUID of error term",
			"type"        : "string",
			"minLength"   : 1
		},

		"checksum": {
			"description" : "Checksum of error term",
			"type"        : "string",
			"minLength"   : 1
		}

	},

	"required": [
		"name",
		"value",
		"units",
		"depth_factor",
		"inclination_factor",
		"azimuth_factor",
		"propagation_mode",
		"depth_formula",
		"inclination_formula",
		"north_singularity",
		"east_singularity",
		"vertical_singularity",
		"azimuth_formula",
		"uuid",
		"checksum"
	],

	"additionalProperties" : false

}

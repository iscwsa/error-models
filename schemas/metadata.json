
{
	"$schema"     : "https://json-schema.org/draft/2020-12/schema",
	"$id"         : "https://github.com/iscwsa/error-models/blob/main/schemas/metadata.json",
	"type"        : "object",
	"title"       : "Metadata",
	"description" : "Information about the model",

	"properties": {

		"model_id": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"short_name": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"long_name": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"revision_number": {
			"description" : "",
			"type"        : "number",
			"minimum"     : 0
		},

		"revision_date": {
			"description" : "",
			"type"        : "string",
			"format"      : "date"
		},

		"revision_comment": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"source": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"application": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"tool_type": {
			"description" : "",
			"type"        : "string",
			"enum": [
				"Gyroscopic",
				"Inertial",
				"Magnetic",
				"Unknown"
			]
		},

		"author": {
			"description" : "",
			"type"        : "string",
			"minLength"   : 1
		},

		"framework": {
			"description": "",
			"type": "string",
			"enum": [
				"Cone",
				"ISCWSA Rev0",
				"ISCWSA Rev1",
				"ISCWSA Rev2",
				"ISCWSA Rev3",
				"ISCWSA Rev4",
				"ISCWSA Rev5",
				"Other",
				"Wolff and de Wardt"
			]
		}

	},

	"required": [
		"model_id",
		"short_name",
		"long_name",
		"revision_number",
		"revision_date",
		"revision_comment",
		"source",
		"application",
		"tool_type",
		"author",
		"framework"
	],

	"additionalProperties" : false

}

{
	"$schema"             : "https://json-schema.org/draft/2020-12/schema",
	"$id"                 : "https://github.com/iscwsa/error-models/blob/main/schema/schema.json",
	"type"                : "object",
	"title"               : "Error Model Schema",
	"description"         : "Provides validation of Error Models",
	"markdownDescription" : "Provides validation of Error Models. See [github.com/iscwsa](https://github.com/iscwsa/error-models)",

	"properties": {

		"$schema": {
			"type": "string"
		},

		"meta": {
			"$ref": "./meta.json"
		},

		"parameters": {
			"$ref": "./parameters.json"
		},

		"tags": {
			"$ref": "./tags.json"
		},

		"error_terms": {
			"$ref": "./error_terms.json"
		}

	},

	"required": [
		"$schema",
		"meta",
		"parameters",
		"tags",
		"error_terms"
	],

	"additionalProperties" : false

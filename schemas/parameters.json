{
	"$schema"     : "https://json-schema.org/draft/2020-12/schema",
	"$id"         : "https://github.com/iscwsa/error-models/blob/main/schema/schema.json",
	"type"        : "object",
	"title"       : "Running Parameters",
	"description" : "Provides validation of Running Parameters",

	"properties": {
		"inc_min": { "type": "integer", "minimum": 0, "maximum": 180 },
		"inc_max": { "type": "integer", "minimum": 0, "maximum": 180 }
	},

	"anyOf": [
		{ "required": [ "inc_min" ] },
		{ "required": [ "inc_max" ] }
	],

	"additionalProperties" : false

}
